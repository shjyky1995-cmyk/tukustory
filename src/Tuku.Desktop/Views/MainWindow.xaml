<Window x:Class="Tuku.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Tuku.Desktop.Views.Converters"
        x:Name="WindowRoot"
        Title="建筑做法资料库" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    </Window.Resources>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="导入图集" IsEnabled="False" />
            <MenuItem Header="手动新建" Click="OnNewPractice" />
            <MenuItem Header="导入任务" IsEnabled="False" />
            <MenuItem Header="资料包" IsEnabled="False" />
            <MenuItem Header="刷新" Click="OnRefresh" />
            <MenuItem Header="设置" IsEnabled="False" />
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock Text="{Binding StatusText}" />
            <Separator />
            <TextBlock Text="CAD：未连接（插入功能暂不可用，可复制纯文字）" />
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180" />
                <ColumnDefinition Width="360" MinWidth="260" />
                <ColumnDefinition Width="*" MinWidth="380" />
            </Grid.ColumnDefinitions>

            <!-- 左栏：浏览 -->
            <DockPanel Grid.Column="0" Margin="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton x:Name="ModeRegionRadio" Content="按地区" IsChecked="True" Checked="OnBrowseModeChanged" />
                    <RadioButton x:Name="ModePartRadio" Content="按部位" Margin="12,0,0,0" Checked="OnBrowseModeChanged" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="浏览（点击节点筛选）" FontWeight="Bold" Margin="0,0,0,4" />
                <TreeView ItemsSource="{Binding Browser.Roots}" BorderThickness="1">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                            <Setter Property="IsExpanded" Value="True" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <TextBlock Text="{Binding Header}" />
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <!-- 中栏：搜索 -->
            <DockPanel Grid.Column="1" Margin="8">
                <StackPanel DockPanel.Dock="Top">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Margin="0,0,4,0"
                                 Text="{Binding Search.Keywords, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding Search.SearchCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="搜索" Width="60" Command="{Binding Search.SearchCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding Search.StatusText}" Margin="0,4,0,0" Foreground="Gray" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Search.ResultsView}"
                         SelectedItem="{Binding Search.SelectedItem}"
                         BorderThickness="1" Margin="0,4,0,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock FontSize="11" Foreground="Gray">
                                    <Run Text="编号：" /><Run Text="{Binding Code, TargetNullValue=（空）}" />
                                    <Run Text="　部位：" /><Run Text="{Binding PartName, TargetNullValue=其他/待分类}" />
                                    <Run Text="　图集：" /><Run Text="{Binding AtlasName, TargetNullValue=手动创建}" />
                                </TextBlock>
                                <TextBlock FontSize="11" Text="未核对">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="DarkOrange" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVerified}" Value="True">
                                                    <Setter Property="Foreground" Value="Green" />
                                                    <Setter Property="Text" Value="已核对" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 右栏：详情与编辑 -->
            <ScrollViewer Grid.Column="2" Margin="8" VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding Editor}"
                            Visibility="{Binding HasPractice, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="做法详情" FontWeight="Bold" Margin="0,0,0,8" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="名称" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontWeight="Bold"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="编号" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Code, TargetNullValue=（空）}"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="主部位" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPartName}"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Parts}"
                                  DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding MainPartId, Mode=TwoWay}"
                                  Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="标签" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TagsText, TargetNullValue=（空）}"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding TagsText, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="备注" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Notes, TargetNullValue=（空）}" TextWrapping="Wrap"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="引用说明" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding ReferenceNote, TargetNullValue=（空）}" TextWrapping="Wrap"
                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ReferenceNote, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="来源" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SourceSummary}" TextWrapping="Wrap" />
                    </Grid>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" Content="已核对" IsChecked="{Binding IsVerified, Mode=TwoWay}" />
                    </Grid>

                    <TextBlock Text="层次（顺序即插入顺序）" FontWeight="SemiBold" Margin="0,12,0,4" />
                    <ListBox x:Name="LayerList" ItemsSource="{Binding Layers}" BorderThickness="1" MaxHeight="220">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding CurrentText}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding OriginalText}" FontSize="10" Foreground="LightGray"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="新增层次" Margin="0,0,4,0" Command="{Binding AddLayerCommand}" />
                        <Button Content="删除所选" Margin="0,0,4,0" Command="{Binding RemoveLayerCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=LayerList}" />
                        <Button Content="上移" Margin="0,0,4,0" Command="{Binding MoveLayerUpCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=LayerList}" />
                        <Button Content="下移" Command="{Binding MoveLayerDownCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=LayerList}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="编辑" Margin="0,0,4,0" Command="{Binding BeginEditCommand}"
                                Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button Content="保存" Margin="0,0,4,0" Command="{Binding SaveCommand}"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="放弃修改" Margin="0,0,4,0" Command="{Binding CancelEditCommand}"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibility}}" />
                        <Button Content="插入 CAD" Margin="0,0,4,0"
                                Command="{Binding Data.InsertToCadCommand, ElementName=WindowRoot}" />
                        <Button Content="复制纯文字" Command="{Binding CopyPlainTextCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Message}" Foreground="DarkRed" Margin="0,8,0,0" TextWrapping="Wrap" />

                    <TextBlock Text="修订历史" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <ListBox x:Name="RevisionList" ItemsSource="{Binding Revisions}" BorderThickness="1" MaxHeight="140"
                             SelectedItem="{Binding SelectedRevision, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding RevisionNumber}" FontWeight="Bold" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Reason}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="恢复所选修订（生成新修订）" Margin="0,4,0,0" HorizontalAlignment="Left"
                            Command="{Binding RestoreRevisionCommand}" />
                    <TextBox Text="{Binding RevisionSnapshotText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                             MinHeight="80" Margin="0,4,0,0" Background="#F5F5F5" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
